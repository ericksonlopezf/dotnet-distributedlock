<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>EricksonLopez.DistributedLock.PostgreSql</AssemblyName>
    <RootNamespace>EricksonLopez.DistributedLock.PostgreSql</RootNamespace>
    <PackageId>EricksonLopez.DistributedLock.PostgreSql</PackageId>
    <Description>High-performance PostgreSQL advisory lock provider implementing IDistributedLockProvider for the EricksonLopez platform. Features 100% Native AOT compatibility, zero-allocation error handling, keepalive heartbeats, and OpenTelemetry instrumentation.</Description>
    <PackageTags>$(CommonPackageTags);postgresql;advisory-lock;npgsql;opentelemetry;transaction-lock</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.DistributedLock.Abstractions\EricksonLopez.DistributedLock.Abstractions.csproj" />
  </ItemGroup>

</Project>
